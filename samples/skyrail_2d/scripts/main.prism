// Skyrail Dash · PrismScript gameplay starter
// Runs offline in PRISM's C++20 interpreter. Adapt the game rules and connect
// action callbacks to the platform input adapter in your project.
var move_speed = 5.2;
var jump_impulse = 8.4;
var score = 0;
func start() { print("Skyrail Dash ready"); }
func update(dt) {
    // Connect virtual actions to the native game input adapter.
    if (dt > 0) { score += 0; }
}
func collect_checkpoint() { score += 100; print("Checkpoint!", score); }
start();
