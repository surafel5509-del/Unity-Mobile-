// Ember Dungeon · PrismScript gameplay starter
// Runs offline in PRISM's C++20 interpreter. Adapt the game rules and connect
// action callbacks to the platform input adapter in your project.
var health = 100;
var keys = 0;
var room_index = 0;
func start() { print("Ember Dungeon ready"); }
func update(dt) { if (health < 1) { print("Game over"); } }
func collect_key() { keys += 1; print("Keys:", keys); }
func enter_room(index) { room_index = index; print("Room:", room_index); }
start();
